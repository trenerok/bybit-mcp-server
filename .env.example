# Bybit MCP Server Configuration

# API Credentials (required for authenticated endpoints)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Network (optional, defaults to mainnet)
# Set to "true" for testnet
BYBIT_TESTNET=false

# Request timeout in milliseconds (optional, default: 5000)
BYBIT_RECV_WINDOW=5000
